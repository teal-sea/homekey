# neural-amp-modeler-wasm lists react and react-dom as peer dependencies for its
# optional React player. This app imports only its engine entry
# (neural-amp-modeler-wasm/engine), which imports nothing, so React is never used.
# With peers left out, `npm ci` and `npm install` match package-lock.json as it was
# made and React never lands in node_modules. The cost: npm no longer checks any
# package's peer ranges here, so check them by hand when upgrading dev tools.
legacy-peer-deps=true
