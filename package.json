{
  "name": "homekey",
  "private": true,
  "version": "0.1.0",
  "description": "Play in a key and mode in the browser: a Neural Amp Modeler amp, a fretboard that follows the key and the note you play, a drone and a looper. Guitar first. Audio never leaves the device.",
  "type": "module",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-engine.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "neural-amp-modeler-wasm": "3.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "22.20.5",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
